# ─────────────────────────────────────────────────────────────────────────────
#  🌊 RPMStream — configuration
#  Copy this file to `.env` and fill in the values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram (required) ──────────────────────────────────────────────────────
# Create an application at https://my.telegram.org → API development tools
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef
# Token from https://t.me/BotFather
BOT_TOKEN=123456789:AA-your-bot-token

# ── RPMShare (required) ──────────────────────────────────────────────────────
# Account → API / Developer settings on https://rpmshare.com
RPMSHARE_API_KEY=your-rpmshare-api-key

# Optional RPMShare tuning
RPMSHARE_API_BASE=https://rpmshare.com
# Page shown by the "🎬 Watch Video" button when RPMShare does not return a link
RPMSHARE_FILE_URL_TEMPLATE=https://rpmshare.com/{file_code}
# RPMSHARE_FOLDER_ID=25
# RPMSHARE_CATEGORY_ID=5
# RPMSHARE_TAGS=uploaded by RPMStream
RPMSHARE_FILE_PUBLIC=true
RPMSHARE_FILE_ADULT=false
RPMSHARE_TITLE_TEMPLATE={file_name}
# How long to poll RPMShare after the transfer (seconds)
RPMSHARE_POLL_INTERVAL=5
RPMSHARE_POLL_TIMEOUT=180
RPMSHARE_API_TIMEOUT=60

# ── Pipeline ─────────────────────────────────────────────────────────────────
# How many uploads may run at the same time
MAX_CONCURRENT_UPLOADS=1
# Bytes read from Telegram per MTProto request (64 KiB … 1 MiB, multiple of 4096)
CHUNK_SIZE=1048576
# Automatic retries for temporary failures
MAX_RETRIES=3
RETRY_BASE_DELAY=3
RETRY_MAX_DELAY=60
# 0 = no wall clock limit on a single transfer
UPLOAD_TIMEOUT=0
# Reject files larger than this (MB). 0 = unlimited.
MAX_FILE_SIZE_MB=0
QUEUE_MAX_ITEMS=250
# Comma separated Telegram user ids. Empty = the bot is public.
ALLOWED_USERS=
# Also accept non video documents (PDFs, archives, …). false = videos only.
ALLOW_ANY_DOCUMENT=false

# ── User interface ───────────────────────────────────────────────────────────
# Seconds between status edits (Telegram flood safe minimum is 1)
PROGRESS_UPDATE_INTERVAL=3
PROGRESS_BAR_WIDTH=16
BOT_TITLE=RPMStream
BOT_TAGLINE=Telegram → RPMShare Streaming
CREATOR_NAME=Salman Biswas
# Custom animated emoji — only rendered by bots that own a Fragment username
# ANIMATED_EMOJI_ID=5368324170671202286
# Optional sticker file ids (get them from @StickerFileIdBot or your own pack)
# STARTUP_STICKER_ID=
# LOADING_STICKER_ID=
# SUCCESS_STICKER_ID=
# ERROR_STICKER_ID=
# Master switch for sending the stage stickers above
SEND_STAGE_STICKERS=false

# ── Storage / logging ────────────────────────────────────────────────────────
# Only the Pyrogram session lives here — video data never touches the disk
SESSION_NAME=rpmstream
WORK_DIR=work
LOG_LEVEL=INFO
LOG_FILE=logs/rpmstream.log
LOG_TO_FILE=true
